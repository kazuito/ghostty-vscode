# =========================================================
# Ghostty debug config
# =========================================================

# ---------------------------------------------------------
# Basic UI / language
# ---------------------------------------------------------
language = en

# ---------------------------------------------------------
# Fonts
# repeatable values, quoted/unquoted, reset-to-default style patterns
# ---------------------------------------------------------
font-family = "JetBrains Mono"
font-family = "Noto Sans Mono"
font-family = "Symbols Nerd Font Mono"

font-family-bold = "JetBrains Mono"
font-family-italic = "JetBrains Mono"
font-family-bold-italic = "JetBrains Mono"

font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = "Bold Italic"

font-synthetic-style = no-bold,no-italic

font-feature = liga
font-feature = dlig
font-feature = ss01

font-size = 14

font-variation = wght=450
font-variation-bold = wght=700
font-variation-italic = slnt=-10
font-variation-bold-italic = wght=700

font-codepoint-map = U+2600-U+26FF=Symbols Nerd Font Mono
font-codepoint-map = U+E000-U+F8FF=Symbols Nerd Font Mono
clipboard-codepoint-map = U+00A0= 

font-thicken = true
font-thicken-strength = 30

font-shaping-break = cursor

adjust-cell-width = 0
adjust-cell-height = 0
adjust-font-baseline = 0
adjust-underline-position = 1
adjust-underline-thickness = 1
adjust-strikethrough-position = 0
adjust-strikethrough-thickness = 1
adjust-overline-position = 0
adjust-overline-thickness = 1
adjust-cursor-thickness = 2
adjust-cursor-height = 0
adjust-box-thickness = 1
adjust-icon-height = 0

grapheme-width-method = unicode
freetype-load-flags = no-monochrome

# ---------------------------------------------------------
# Theme / colors
# ---------------------------------------------------------
theme = "Tokyo Night"

background = 1a1b26
foreground = c0caf5

selection-foreground = 1a1b26
selection-background = 7aa2f7
selection-clear-on-typing = true
selection-clear-on-copy = false
selection-word-chars = "-_./:@"

minimum-contrast = 1.1
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette-generate = false
palette-harmonious = true

bold-color = bright
faint-opacity = 0.65

cursor-color = cell-foreground
cursor-opacity = 0.9
cursor-style = block
cursor-style-blink = true
cursor-text = 1a1b26
cursor-click-to-move = false

search-foreground = 000000
search-background = ffdd57
search-selected-foreground = ffffff
search-selected-background = 7c3aed

# ---------------------------------------------------------
# Background image / transparency / blur
# ---------------------------------------------------------
background-image = ~/.config/ghostty/backgrounds/noise.png
background-image-opacity = 0.08
background-image-position = center
background-image-fit = cover
background-image-repeat = false

background-opacity = 0.94
background-opacity-cells = false
background-blur = 20
alpha-blending = native

unfocused-split-opacity = 0.8
unfocused-split-fill = 0f1117
split-divider-color = 2f334d
split-preserve-zoom = true

# ---------------------------------------------------------
# Mouse / scrolling
# ---------------------------------------------------------
mouse-hide-while-typing = true
scroll-to-bottom = false
mouse-shift-capture = true
mouse-reporting = true
mouse-scroll-multiplier = 1.5

scrollback-limit = 200000
scrollbar = always

# ---------------------------------------------------------
# Links
# ---------------------------------------------------------
link-url = true
link-previews = true

# ---------------------------------------------------------
# Command / shell / environment
# ---------------------------------------------------------
command = /bin/zsh --login
initial-command = echo "Ghostty debug profile loaded"

env = EDITOR=nvim
env = LANG=en_US.UTF-8
env = COLORTERM=truecolor
env = DEBUG_GHOSTTY=1

wait-after-command = false
notify-on-command-finish = never
notify-on-command-finish-action = bell
notify-on-command-finish-after = 5d
abnormal-command-exit-runtime = 250

working-directory = ~/Projects
term = xterm-ghostty
enquiry-response = yes

shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ---------------------------------------------------------
# Clipboard / terminal safety
# ---------------------------------------------------------
clipboard-read = allow
clipboard-write = deny
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

copy-on-select = false
title-report = false
image-storage-limit = 100000000
right-click-action = paste
click-repeat-interval = 3h
vt-kam-allowed = false

# ---------------------------------------------------------
# Window / tabs / layout
# ---------------------------------------------------------
maximize = false
fullscreen = false
title = "Ghostty Debug"
class = com.example.ghostty-debug
x11-instance-name = ghostty-debug

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = 11121d
window-vsync = true

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = true

window-decoration = true
window-title-font-family = Inter
window-subtitle = "sample config"
window-theme = auto
window-colorspace = srgb
window-height = 48
window-width = 140
window-position-x = 120
window-position-y = 80
window-save-state = always
window-step-resize = true
window-new-tab-position = end
window-show-tab-bar = auto
window-titlebar-background = 1a1b26
window-titlebar-foreground = c0caf5

resize-overlay = never
resize-overlay-position = center
resize-overlay-duration = 750m

focus-follows-mouse = false

# ---------------------------------------------------------
# Confirm / lifecycle
# ---------------------------------------------------------
confirm-close-surface = always
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 0m
initial-window = true
undo-timeout = 5y

# ---------------------------------------------------------
# Quick terminal
# ---------------------------------------------------------
quick-terminal-position = top
quick-terminal-size = 0.42%
quick-terminal-screen = main
quick-terminal-animation-duration = 180s
quick-terminal-autohide = true
quick-terminal-space-behavior = move
quick-terminal-keyboard-interactivity = on-demand

# GTK-specific quick terminal options
gtk-quick-terminal-layer = overlay
gtk-quick-terminal-namespace = ghostty-debug

# ---------------------------------------------------------
# Key remaps / keybinds
# repeatable keys, sequences, performable action pattern
# ---------------------------------------------------------
key-remap = caps_lock=escape
key-remap = right_alt=alt

keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>s=new_split:down
keybind = performable:ctrl+shift+g=open_selection
keybind = super+shift+enter=toggle_quick_terminal

# ---------------------------------------------------------
# Command palette / custom entries
# ---------------------------------------------------------
command-palette-entry = "Open dotfiles=goto_tab:1"
command-palette-entry = "Reload config=reload_config"
command-palette-entry = "Toggle fullscreen=toggle_fullscreen"

# ---------------------------------------------------------
# Shader / bell
# ---------------------------------------------------------
custom-shader = ~/.config/ghostty/shaders/vignette.glsl
custom-shader = ~/.config/ghostty/shaders/grain.glsl
custom-shader-animation = false

bell-features = audio,border
bell-audio-path = ~/.config/ghostty/sounds/pop.wav
bell-audio-volume = 0.4

app-notifications = no-clipboard-paste
desktop-notifications = true
progress-style = floating

# ---------------------------------------------------------
# Config splitting
# config-file can be repeated; ? prefix means optional
# ---------------------------------------------------------
config-file = ~/.config/ghostty/themes/local-overrides.ghostty
config-file = ?~/.config/ghostty/machine-specific.ghostty
config-file = ?~/.config/ghostty/platform-macos.ghostty

# ---------------------------------------------------------
# macOS-specific
# ---------------------------------------------------------
macos-non-native-fullscreen = false
macos-window-buttons = visible
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
macos-dock-drop-behavior = new-tab
macos-option-as-alt = false
macos-window-shadow = true
macos-hidden = false
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-applescript = deny
macos-icon = official
macos-custom-icon = ~/Pictures/ghostty.icns
macos-icon-frame = aluminum
macos-icon-ghost-color = c0caf5
macos-icon-screen-color = 1a1b26,7aa2f7,bb9af7
macos-shortcuts = ask

# ---------------------------------------------------------
# Linux-specific
# ---------------------------------------------------------
linux-cgroup = always
linux-cgroup-memory-limit = 1073741824
linux-cgroup-processes-limit = 256
linux-cgroup-hard-fail = false

gtk-opengl-debug = false
gtk-single-instance = true
gtk-titlebar = true
gtk-tabs-location = top
gtk-titlebar-hide-when-maximized = true
gtk-toolbar-style = flat
gtk-titlebar-style = primary
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/ghostty.css

# ---------------------------------------------------------
# Misc
# ---------------------------------------------------------
config-default-files = true
input = ~/.config/ghostty/fragments/generated-input.conf
