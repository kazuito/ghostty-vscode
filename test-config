# Ghostty Configuration Test File

# Basic colors
background = #282c34
foreground = #ffffff

# Font configuration
font-family = JetBrains Mono
font-size = 14

# Window settings
window-padding-x = 10
window-padding-y = 10

# Theme
theme = catppuccin-frappe

# Keybindings
keybind = ctrl+c=copy_to_clipboard
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+shift+t=new_tab

# Boolean settings
cursor-style-blink = true
copy-on-select = false

# Palette colors
palette = 0=#1d2021
palette = 1=#cc241d
palette = 15=#fbf1c7