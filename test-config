# Ghostty sample config for testing syntax highlighting, parsing, repeatable keys,
# quoted/unquoted strings, enums, numbers, booleans, paths, colors, codepoint maps,
# keybinds, env vars, and platform-specific options.
#
# This file is intentionally broad, not minimal.
# Some options are platform-specific and may be ignored depending on OS/build.

# ------------------------------
# General
# ------------------------------
language = en
title = "Ghostty Debug Config"
class = ghostty-debug
window-subtitle = "syntax test"
window-theme = dark
window-colorspace = srgb
working-directory = ~
term = xterm-ghostty

# ------------------------------
# Fonts
# ------------------------------
font-family = JetBrainsMono Nerd Font
font-family = Noto Sans Mono CJK JP
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font

font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic

font-size = 14
font-thicken = true
font-thicken-strength = 80

font-synthetic-style = bold,italic
font-feature = liga
font-feature = calt
font-feature = ss01

font-variation = wght=450
font-variation-bold = wght=700
font-variation-italic = wght=450
font-variation-bold-italic = wght=700

font-shaping-break = cursor

# codepoint maps
font-codepoint-map = U+2500-U+257F=Symbols Nerd Font
font-codepoint-map = U+E000-U+F8FF=Symbols Nerd Font
clipboard-codepoint-map = U+00A0= 

# rendering adjustments
adjust-cell-width = 0
adjust-cell-height = 0
adjust-font-baseline = 0
adjust-underline-position = 1
adjust-underline-thickness = 1
adjust-strikethrough-position = 0
adjust-strikethrough-thickness = 1
adjust-overline-position = 0
adjust-overline-thickness = 1
adjust-cursor-thickness = 2
adjust-cursor-height = 100
adjust-box-thickness = 1
adjust-icon-height = 0

grapheme-width-method = unicode
freetype-load-flags = default
alpha-blending = linear-corrected

# ------------------------------
# Theme / Colors
# ------------------------------
theme = Dracula
background = #101217
foreground = #e6edf3

selection-foreground = #ffffff
selection-background = #3b82f6
selection-clear-on-typing = true
selection-clear-on-copy = false
selection-word-chars = "-_./:"

minimum-contrast = 1.1
palette = 0=#1f2430
palette = 1=#ff6b6b
palette-generate = false
palette-harmonious = false

bold-color = bright
faint-opacity = 0.55

# cursor
cursor-color = cell-foreground
cursor-opacity = 0.95
cursor-style = block
cursor-style-blink = true
cursor-text = #101217
cursor-click-to-move = false

# search
search-foreground = #111827
search-background = #fde68a
search-selected-foreground = #ffffff
search-selected-background = #f59e0b

# background image / opacity
background-opacity = 0.92
background-opacity-cells = 1.0
background-blur = 20
background-image = "~/Pictures/wallpapers/debug.png"
background-image-opacity = 0.12
background-image-position = center
background-image-fit = cover
background-image-repeat = false

# split UI
unfocused-split-opacity = 0.80
unfocused-split-fill = #0f172a
split-divider-color = #334155
split-preserve-zoom = true

# ------------------------------
# Mouse / Scroll / Links
# ------------------------------
mouse-hide-while-typing = true
scroll-to-bottom = false
mouse-shift-capture = true
mouse-reporting = true
mouse-scroll-multiplier = 1.5

scrollback-limit = 200000
scrollbar = always

link-url = true
link-previews = false

# ------------------------------
# Shell / Command / Environment
# ------------------------------
command = /bin/zsh --login
initial-command = echo "hello from ghostty"
wait-after-command = false
abnormal-command-exit-runtime = 1000

notify-on-command-finish = true
notify-on-command-finish-action = toast
notify-on-command-finish-after = 3000

env = LANG=en_US.UTF-8
env = EDITOR=nvim
env = FOO=bar baz
env = PATH=/opt/homebrew/bin:$PATH

input = ~/.config/ghostty/includes/base.conf
input = ~/.config/ghostty/includes/local.conf

# ------------------------------
# Window / Tabs / Layout
# ------------------------------
maximize = false
fullscreen = false
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = #101217
window-vsync = true

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = true

window-decoration = true
window-title-font-family = SF Pro Text
window-height = 900
window-width = 1440
window-position-x = 120
window-position-y = 80
window-save-state = true
window-step-resize = true
window-new-tab-position = end
window-show-tab-bar = true
window-titlebar-background = #0f172a
window-titlebar-foreground = #e5e7eb

resize-overlay = true
resize-overlay-position = center
resize-overlay-duration = 600

focus-follows-mouse = false

# ------------------------------
# Clipboard / Selection
# ------------------------------
clipboard-read = true
clipboard-write = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
copy-on-select = false

# ------------------------------
# Reporting / Terminal behavior
# ------------------------------
title-report = true
image-storage-limit = 32000000
right-click-action = paste
click-repeat-interval = 300
confirm-close-surface = always
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 0
initial-window = true
undo-timeout = 5000
enquiry-response = "ghostty-debug"

# ------------------------------
# Quick terminal
# ------------------------------
quick-terminal-position = top
quick-terminal-size = 0.42
quick-terminal-screen = main
quick-terminal-animation-duration = 180
quick-terminal-autohide = true
quick-terminal-space-behavior = move
quick-terminal-keyboard-interactivity = true

# GTK quick terminal knobs
gtk-quick-terminal-layer = overlay
gtk-quick-terminal-namespace = ghostty-debug

# ------------------------------
# Shell integration / command palette
# ------------------------------
shell-integration = true
shell-integration-features = cursor,sudo,title
command-palette-entry = "Open dotfiles=exec:/bin/zsh -lc 'cd ~/.config && exec zsh'"
command-palette-entry = "Reload config=reload_config"
osc-color-report-format = 16bit
vt-kam-allowed = false

# ------------------------------
# Custom shaders / bell / notifications
# ------------------------------
custom-shader = ~/.config/ghostty/shaders/noise.glsl
custom-shader = ~/.config/ghostty/shaders/vignette.glsl
custom-shader-animation = true

bell-features = audio,visual
bell-audio-path = ~/.config/ghostty/sounds/bell.wav
bell-audio-volume = 0.4

app-notifications = true
desktop-notifications = true
progress-style = true

# ------------------------------
# Keybindings (repeatable)
# ------------------------------
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+alt+enter=toggle_fullscreen
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+shift+r=reload_config
keybind = super+k=clear_screen

# example remaps
key-remap = caps_lock=escape
key-remap = super+left=home
key-remap = super+right=end

# ------------------------------
# Config includes
# ------------------------------
config-default-files = true
config-file = ~/.config/ghostty/themes/debug-extra.conf
config-file = ~/.config/ghostty/overrides/work.conf

# ------------------------------
# macOS-specific
# ------------------------------
macos-non-native-fullscreen = false
macos-window-buttons = visible
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = true
macos-dock-drop-behavior = new-tab
macos-option-as-alt = both
macos-window-shadow = true
macos-hidden = false
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-applescript = true
macos-icon = official
macos-custom-icon = ~/Pictures/ghostty/icon.png
macos-icon-frame = #1f2937
macos-icon-ghost-color = #93c5fd
macos-icon-screen-color = #0f172a,#1e293b,#334155
macos-shortcuts = ask

# ------------------------------
# Linux-specific
# ------------------------------
linux-cgroup = false
linux-cgroup-memory-limit = 0
linux-cgroup-processes-limit = 0
linux-cgroup-hard-fail = false

# ------------------------------
# GTK-specific
# ------------------------------
gtk-opengl-debug = false
gtk-single-instance = true
gtk-titlebar = true
gtk-tabs-location = top
gtk-titlebar-hide-when-maximized = true
gtk-toolbar-style = flat
gtk-titlebar-style = default
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/debug.css
gtk-custom-css = ~/.config/ghostty/more-debug.css

# ------------------------------
# Misc
# ------------------------------
x11-instance-name = ghostty-debug
config-file = ~/.config/ghostty/final.conf
