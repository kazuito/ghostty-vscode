// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: watch",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "watch"
      ],
      "problemMatcher": [
        {
          "owner": "rolldown",
          "pattern": {
            "regexp": "^(?!x)x"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^> ghostty@.+ watch .*$",
            "endsPattern": "^✔ Rebuilt .*$"
          }
        }
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
