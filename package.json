{
  "name": "ghostty",
  "displayName": "Ghostty",
  "description": "Support for Ghostty configurations.",
  "version": "0.0.1",
  "publisher": "kazuito",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazuito/ghostty-vscode.git"
  },
  "homepage": "https://github.com/kazuito/ghostty-vscode",
  "bugs": {
    "url": "https://github.com/kazuito/ghostty-vscode/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/client/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/node": "18.x",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0",
    "vscode-languageserver": "^8.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ghostty-config",
        "aliases": [
          "Ghostty Config",
          "ghostty-config"
        ],
        "filenames": [
          "config"
        ],
        "extensions": [
          ".ghostty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghostty-config",
        "scopeName": "source.ghostty",
        "path": "./syntaxes/ghostty-config.tmLanguage.json"
      }
    ]
  }
}
