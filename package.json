{
  "name": "ghostty",
  "displayName": "Ghostty",
  "description": "Support for Ghostty configurations.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ghostty-config",
        "aliases": [
          "Ghostty Config",
          "ghostty-config"
        ],
        "filenames": [
          "config"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghostty-config",
        "scopeName": "source.ghostty",
        "path": "./syntaxes/ghostty-config.tmLanguage.json"
      }
    ]
  }
}
