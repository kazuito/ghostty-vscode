{
  "name": "ghostty",
  "displayName": "Ghostty",
  "description": "Support for Ghostty configurations.",
  "version": "1.0.0",
  "publisher": "kazuito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazuito/ghostty-vscode.git"
  },
  "homepage": "https://github.com/kazuito/ghostty-vscode",
  "bugs": {
    "url": "https://github.com/kazuito/ghostty-vscode/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ghostty",
    "terminal",
    "config",
    "syntax highlighting",
    "language support"
  ],
  "icon": "icon.png",
  "main": "./out/client/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "~25.5.0",
    "@types/vscode": "^1.100.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ghostty-config",
        "aliases": [
          "Ghostty Config",
          "ghostty-config"
        ],
        "filenamePatterns": [
          "**/ghostty/config",
          "**/com.mitchellh.ghostty/config"
        ],
        "extensions": [
          ".ghostty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghostty-config",
        "scopeName": "source.ghostty",
        "path": "./syntaxes/ghostty-config.tmLanguage.json"
      }
    ]
  }
}
