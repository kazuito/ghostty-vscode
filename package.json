{
	"name": "ghostty",
	"displayName": "Ghostty",
	"description": "Support for Ghostty configurations.",
	"version": "0.0.1",
	"publisher": "kazuito",
	"repository": {
		"type": "git",
		"url": "https://github.com/kazuito/ghostty-vscode.git"
	},
	"homepage": "https://github.com/kazuito/ghostty-vscode",
	"bugs": {
		"url": "https://github.com/kazuito/ghostty-vscode/issues"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Programming Languages"
	],
	"icon": "icon.png",
	"main": "./out/client/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"test": "node ./out/test/runTest.js",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "~25.5.0",
		"@types/vscode": "^1.110.0",
		"@typescript-eslint/eslint-plugin": "^8.57.0",
		"@typescript-eslint/parser": "^8.57.0",
		"eslint": "^10.0.3",
		"husky": "^9.1.7",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1",
		"vscode-languageserver": "^9.0.1",
		"vscode-languageserver-textdocument": "^1.0.12",
		"zod": "^4.3.6"
	},
	"contributes": {
		"languages": [
			{
				"id": "ghostty-config",
				"aliases": [
					"Ghostty Config",
					"ghostty-config"
				],
				"filenames": [
					"config"
				],
				"extensions": [
					".ghostty"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ghostty-config",
				"scopeName": "source.ghostty",
				"path": "./syntaxes/ghostty-config.tmLanguage.json"
			}
		]
	}
}
